# ---------------------------------------------------------------------------
# GoldMiner backend - environment configuration
# Copy to `.env` (same folder as server.js) and adjust, then restart the
# service (`npm start` or your process manager).
#
# This backend is READ-ONLY: it only ever reads goldminer_snapshot_*.json
# files written by mt5-bridge/GoldMinerMonitor.mq5 and serves GET requests
# (plus PATCH for the dashboard's own alert read/unread flag). It has no
# route that can reach MT5, and none may ever be added — see
# ../docs/READ_ONLY.md.
#
# NEVER put an MT5 password here. This backend never logs into MT5 itself —
# it only reads the JSON files the monitor EA already wrote to disk.
# ---------------------------------------------------------------------------

# Port the backend listens on.
PORT=4000

# Folder the monitor EA writes goldminer_snapshot_<login>.json into. This is
# always the MT5 "Common\Files" folder, shared by every terminal on this
# machine regardless of which one is running the EA:
#   %APPDATA%\MetaQuotes\Terminal\Common\Files
# On this machine that resolves to:
SNAPSHOT_DIR=C:\Users\hp\AppData\Roaming\MetaQuotes\Terminal\Common\Files

# How often to re-read the snapshot folder, in milliseconds.
SNAPSHOT_POLL_MS=2000

# A snapshot file older than this many minutes is treated as stale even if
# the JSON inside says the terminal is connected — mirrors the dashboard's
# own STALE_HEARTBEAT_MINUTES (src/lib/accounts.ts).
STALE_HEARTBEAT_MINUTES=5

# CORS origin allowed to call this API. Set this to your dashboard's exact
# origin once deployed (e.g. https://goldminer.yourdomain.com); "*" is fine
# for local development only.
CORS_ORIGIN=*

# Optional shared-secret auth. When set, every request must send
# `Authorization: Bearer <this value>`. Strongly recommended once this
# backend is reachable from the internet (e.g. on the VPS). Leave blank only
# for local-machine testing.
API_KEY=

# JSON map of MT5 login -> "MASTER" | "SLAVE". Any login not listed defaults
# to MASTER. Only meaningful once you run a trade copier with slave accounts;
# a single account needs no entry here.
ACCOUNT_ROLES={}

# IST hour (0-23) the GoldMiner trading day resets at, for the "today's P/L"
# boundary. Matches the monitor EA's InpDayResetHourIST and the dashboard's
# stated trading day start.
DAY_RESET_HOUR_IST=4
