# ---------------------------------------------------------------------------
# GoldMiner Dashboard - environment configuration
# Copy to `.env.local` and adjust, then restart `npm run dev`.
#
# NEVER put broker credentials, MT5 passwords or API secrets in this file.
# Every NEXT_PUBLIC_ variable is shipped to the browser.
#
# (This is a Next.js app, so variables use NEXT_PUBLIC_ — VITE_ names are ignored.)
#
# There is no mock/demo data mode. This dashboard is READ-ONLY and always
# talks to a real backend at NEXT_PUBLIC_API_BASE_URL. If it is unreachable,
# screens show an error state — nothing here ever falls back to fake numbers.
# ---------------------------------------------------------------------------

# Backend base URL. Point this at your real read-only backend once it exists.
# There is no local fallback server in this repo.
NEXT_PUBLIC_API_BASE_URL=https://api.your-backend.example

# Live update transport.
#   polling   -> refetch on an interval (default)
#   websocket -> connect to NEXT_PUBLIC_REALTIME_URL (backend not built yet)
NEXT_PUBLIC_REALTIME_TRANSPORT=polling
NEXT_PUBLIC_POLL_INTERVAL_MS=8000
NEXT_PUBLIC_REALTIME_URL=

# Display defaults
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_TRADING_TIMEZONE=Asia/Kolkata

# Web Push public (VAPID) key. Safe to expose; the private key stays on the backend.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional shared-secret sent as `Authorization: Bearer <key>` on every request.
# Must match the backend's API_KEY. This is a browser-visible value (it has
# to be, to be sent from the browser) — it is not a broker credential, just a
# gate so a random internet client can't read your account data. Leave blank
# for local-machine testing only.
NEXT_PUBLIC_API_KEY=
