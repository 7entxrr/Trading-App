# Copy to .env.local for local development (never commit .env.local).
# On the real deployment (Vercel / VPS), set these as server environment variables.
# NEVER prefix these with NEXT_PUBLIC_ — they must stay on the server.

# GoldMiner API base URL (optional; this is the default)
GOLDMINER_API_BASE_URL=https://goldminer-api.srv1995263.hstgr.cloud

# Bearer token for the GoldMiner API. Server-only.
GOLDMINER_API_TOKEN=

# Passcode you type to unlock the app. Choose a long, unique value.
GOLDMINER_APP_PASSCODE=
